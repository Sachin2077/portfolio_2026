# The footer contact form sends notes through Resend (resend.com).
# Copy this file to .env.local and fill in the values. On Vercel, add them as environment variables,
# or install the Resend integration from the Vercel Marketplace, which sets RESEND_API_KEY for you.

# An API key from your Resend account. Never commit the real key.
RESEND_API_KEY=

# Where notes arrive. Defaults to the email in src/content/site.js.
CONTACT_TO=

# Who the note is sent from. It must use a domain verified in Resend, for example
# "Portfolio <hello@sachinverma.site>". Until a domain is verified, leave it empty: Resend's test
# sender is used, and it only delivers to the email address of your Resend account.
CONTACT_FROM=
